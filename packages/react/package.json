{
  "name": "composerkit",
  "version": "0.1.0",
  "description": "React components for chat interfaces, built on shadcn/ui and Base UI",
  "keywords": [
    "base-ui",
    "chat",
    "chatbot",
    "components",
    "design-system",
    "react",
    "shadcn",
    "tailwind",
    "ui"
  ],
  "homepage": "https://github.com/Snestra/ComposerKit#readme",
  "bugs": {
    "url": "https://github.com/Snestra/ComposerKit/issues"
  },
  "license": "MIT",
  "author": "Bjørn Aagaard",
  "repository": {
    "type": "github",
    "url": "https://github.com/Snestra/ComposerKit"
  },
  "files": [
    "dist",
    "postcss.config.mjs"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./components/*": "./src/components/*",
    "./lib/*": "./src/lib/*",
    "./hooks/*": "./src/hooks/*"
  },
  "publishConfig": {
    "exports": {
      "./components/*": {
        "types": "./dist/components/*.d.ts",
        "default": "./dist/components/*.js"
      },
      "./lib/*": {
        "types": "./dist/lib/*.d.ts",
        "default": "./dist/lib/*.js"
      },
      "./hooks/*": {
        "types": "./dist/hooks/*.d.ts",
        "default": "./dist/hooks/*.js"
      },
      "./styles.css": "./dist/styles/globals.css",
      "./globals.css": "./dist/styles/globals.css",
      "./postcss.config": "./postcss.config.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "node scripts/build.ts && tsc -p tsconfig.build.json && node scripts/finish-dist.ts",
    "prepack": "pnpm run build",
    "lint:design": "node --input-type=module -e 'import { readFileSync } from \"node:fs\"; import { lint } from \"@google/design.md/linter\"; const report = lint(readFileSync(process.argv[1] ?? \"DESIGN.md\", \"utf8\")); for (const finding of report.findings) console.log(`${finding.severity}: ${finding.rule ?? \"parser\"}: ${finding.path ?? \"\"} ${finding.message}`); if (report.summary.errors || report.findings.some((finding) => finding.rule === \"contrast-ratio\")) process.exitCode = 1;'",
    "export:design": "pnpm run lint:design && design.md export DESIGN.md --format css-tailwind > src/styles/design-tokens.css",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@floating-ui/react-dom": "^2.1.9",
    "@lezer/highlight": "^1.2.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.66.0",
    "mermaid": "^12.3.0",
    "next-themes": "^0.4.6",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.4",
    "prosemirror-view": "^1.42.9",
    "refractor": "^5.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@google/design.md": "^0.4.0",
    "@tailwindcss/postcss": "^4",
    "@types/hast": "^3.0.5",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "dependency-cruiser": "^18.7.2",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "next": "^16.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  }
}
